API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_ID=xxxx
DUMP_CHANNEL_ID=-100xxxxxxxxxx

# Logging (trace | debug | info | warn | error)
LOG_LEVEL=info

# PostgreSQL connection (required in production)
DATABASE_URL=postgresql://user:password@localhost:5432/peerless

# Database integration tests require an explicit isolated test database URL.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/peerless_test

# Primary decryption mirror (optional — dynamic manifest resolution by default)
# ALAC_MIRROR_URL=https://custom-mirror.example.com
# ALAC_API_KEY=your_key_here

# Fallback wrapper engine (defaults to local wrapper at http://127.0.0.1:12340):
# When the primary mirror is down or times out, the bot automatically switches here.
ALAC_WRAPPER_URL=http://127.0.0.1:12340
# ALAC_WRAPPER_API_KEY=

# Retries & exponential backoff:
# ALAC_MAX_RETRIES=3
# ALAC_RETRY_BASE_MS=2000

# Qobuz backend & ripping configuration:
# Hosted worker backend (primary)
QOBUZ_BACKEND_URL=
QOBUZ_BACKEND_KEY=

# Native Rust ripping fallback (when account is available)
# QOBUZ_USER_AUTH_TOKEN=
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=

# Required: signs stream tickets and derives the at-rest encryption key for stored
# Last.fm/ListenBrainz tokens and worker sessions. Startup fails when it is unset
# or shorter than 32 characters. Generate one with: openssl rand -hex 32
APP_KEY=

# Optional: fallback secret for AES-256-GCM encryption of stored Telegram worker
# sessions; only consulted when APP_KEY is absent from the environment.
# SESSION_ENCRYPTION_KEY=

# Optional: stream worker pool (one auxiliary Telegram bot token per entry,
# comma-separated). Unset/empty falls back to the primary bot client.
# STREAM_WORKER_BOT_TOKENS=

# Optional: overrides the stream server port stored in application settings
# (defaults to 4444, and is also read by healthcheck.sh inside the container).
# STREAM_SERVER_PORT=4444

# Optional: set to "endpoints" to use endpoint mode; any other value uses the
# native wrapper mode.
# ALAC_WRAPPER_KIND=

# Optional: Apple acquisition retry rounds (default: 3; values <= 0 are ignored).
# ALAC_STREAM_RETRIES=
# Optional: Apple acquisition retry base delay in milliseconds (default: 2000; capped at 30000).
# ALAC_STREAM_RETRY_BASE_MS=

LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
